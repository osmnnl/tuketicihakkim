---
import { cases, frames } from "../lib/cases";

/**
 * Hero arka planı: senaryo başlıklarından örülmüş konu ağı.
 * Düğümler kategori kümelerine yerleşir, aynı kümedeki komşular çizgiyle bağlanır.
 * Tamamen canvas'a çizilir — DOM'a yüzlerce element eklemez.
 */
const NODE_LIMIT = 300;

// Kategoriye göre grupla, her gruptan orantılı örneklem al (deterministik)
const byFrame = new Map<string, string[]>();
for (const c of cases) {
  const list = byFrame.get(c.frame) ?? [];
  list.push(c.title.length <= 30 ? c.title : c.aliases[0] ?? c.title);
  byFrame.set(c.frame, list);
}

const total = cases.length;
const nodes: { t: string; v: string; f: string }[] = [];
for (const [frame, titles] of byFrame) {
  const quota = Math.max(3, Math.round((titles.length / total) * NODE_LIMIT));
  const step = Math.max(1, Math.floor(titles.length / quota));
  for (let i = 0; i < titles.length && nodes.length < NODE_LIMIT; i += step) {
    const c = cases.find((x) => x.frame === frame && (x.title === titles[i] || x.aliases[0] === titles[i]));
    nodes.push({ t: titles[i], v: c?.verdict ?? "var", f: frame });
  }
}

const frameIds = [...byFrame.keys()];
const payload = { nodes, frames: frameIds, labels: frameIds.map((f) => frames[f].category) };
---

<div class="hero-net" aria-hidden="true">
  <canvas id="hero-net-canvas"></canvas>
</div>

<script type="application/json" id="hero-net-data" is:inline set:html={JSON.stringify(payload)} />

<script is:inline>
  (() => {
    const canvas = document.getElementById("hero-net-canvas");
    const dataEl = document.getElementById("hero-net-data");
    if (!canvas || !dataEl) return;

    const { nodes, frames, labels } = JSON.parse(dataEl.textContent);
    const ctx = canvas.getContext("2d");

    // Deterministik rastgelelik — her yüklemede aynı ağ çizilir
    const rng = (seed) => () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);

    // Tek renk ailesi: nötr taban + seyrek yeşil vurgu. Doygun çok renk gürültü yapıyor.
    const PALETTE = {
      dark:  { base: "148,158,175", accent: "74,222,128", edge: "160,175,195" },
      light: { base: "90,100,115",  accent: "18,138,69",  edge: "70,85,105" },
    };

    const isLight = () => {
      const t = document.documentElement.dataset.theme;
      if (t === "light") return true;
      if (t === "dark") return false;
      return window.matchMedia("(prefers-color-scheme: light)").matches;
    };

    let placed = [];

    function layout(w, h) {
      const rand = rng(20260911);
      const compact = w < 760;
      const count = compact ? Math.round(nodes.length * 0.30) : nodes.length;

      // Her kategori için bir küme merkezi — altın açıyla dağıtılır
      const centers = frames.map((_, i) => {
        const a = i * 2.399963;
        const r = 0.30 + 0.26 * Math.sqrt((i + 0.6) / frames.length);
        return { x: 0.5 + Math.cos(a) * r * 1.30, y: 0.5 + Math.sin(a) * r * 1.02 };
      });

      const out = [];

      // Kategori adları: her kümenin merkezinde büyük ve belirgin "hub" düğümü
      centers.forEach((c, ci) => {
        const x = c.x * w, y = c.y * h;
        const dx = (x / w - 0.5) / 0.5, dy = (y / h - 0.5) / 0.5;
        const dist = Math.min(1, Math.hypot(dx, dy));
        if (dist < (compact ? 0.52 : 0.40)) return;
        out.push({
          t: labels[ci], f: frames[ci], x, y,
          size: compact ? 13 : 20, alpha: (compact ? 0.20 : 0.30) + 0.22 * dist,
          cluster: ci, accent: true, hub: true,
        });
      });

      for (let i = 0; i < count; i++) {
        const n = nodes[Math.floor((i * nodes.length) / count)];
        const ci = frames.indexOf(n.f);
        const c = centers[ci < 0 ? 0 : ci];
        const ang = rand() * Math.PI * 2;
        const rad = Math.pow(rand(), 0.6) * (compact ? 0.22 : 0.19);
        let x = (c.x + Math.cos(ang) * rad * 1.45) * w;
        let y = (c.y + Math.sin(ang) * rad * 1.1) * h;

        // merkezden uzaklık (0 = tam orta, 1 = kenar)
        const dx = (x / w - 0.5) / 0.5, dy = (y / h - 0.5) / 0.5;
        const dist = Math.min(1, Math.hypot(dx, dy));

        // ortadaki metin alanına düşen düğümleri dışarı it
        const hole = compact ? 0.52 : 0.42;
        if (dist < hole) {
          const push = hole / Math.max(dist, 0.06);
          x = w / 2 + (x - w / 2) * push;
          y = h / 2 + (y - h / 2) * push;
        }

        const size = (compact ? 9.5 : 11) + rand() * (compact ? 3 : 5.5);
        // kenara yaklaştıkça hafifçe belirginleşsin, merkeze yakın olan iyice sönsün
        const alpha = (0.20 + rand() * 0.36) * (0.45 + 0.75 * Math.min(1, dist * 1.4));
        out.push({ ...n, x, y, size, alpha, cluster: ci, accent: rand() < 0.18 });
      }
      return out;
    }

    let nodesP = [];   // yerleştirilmiş düğümler
    let edges = [];    // bir kez hesaplanan bağlantılar
    let W = 0, H = 0, DPR = 1;
    let pan = { x: 0, y: 0 };          // sürükleme kaydırması
    let target = { x: 0, y: 0 };       // fare parallax hedefi
    let ease = { x: 0, y: 0 };         // yumuşatılmış parallax
    let intro = 0;                     // 0→1 açılış ilerlemesi
    let running = false;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /** Yerleşim + bağlantı listesi: kare başına değil, ölçü değişince hesaplanır. */
    function build() {
      const host = canvas.parentElement;
      W = host.clientWidth;
      H = host.clientHeight;
      if (!W || !H) return false;

      DPR = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = W * DPR;
      canvas.height = H * DPR;
      canvas.style.width = W + "px";
      canvas.style.height = H + "px";

      nodesP = layout(W, H);

      // her düğüme kendi yörünge fazı ve hızı
      const rand = rng(97531);
      for (const n of nodesP) {
        n.bx = n.x; n.by = n.y;                      // taban konum
        n.ph = rand() * Math.PI * 2;                 // faz
        n.sp = 0.10 + rand() * 0.22;                 // salınım hızı
        n.amp = (n.hub ? 5 : 9) + rand() * 10;       // genlik
        n.depth = 0.35 + rand() * 0.9;               // parallax derinliği
      }

      // bağlantılar bir kez: düğümler yavaş hareket ettiğinden sabit kalabilir
      edges = [];
      const maxLink = Math.min(W, H) * (W < 760 ? 0.62 : 0.52);
      for (let i = 0; i < nodesP.length; i++) {
        const a = nodesP[i];
        let links = 0;
        for (let j = i + 1; j < nodesP.length && links < 5; j++) {
          const b = nodesP[j];
          const same = a.cluster === b.cluster;
          const d = Math.hypot(a.bx - b.bx, a.by - b.by);
          const limit = same ? maxLink : maxLink * 0.72;
          if (d > limit) continue;
          const mx = (a.bx + b.bx) / 2 / W - 0.5, my = (a.by + b.by) / 2 / H - 0.5;
          const mid = Math.min(1, Math.hypot(mx / 0.5, my / 0.5));
          edges.push({ a: i, b: j, w: (1 - d / limit) * (same ? 0.62 : 0.34) * (0.40 + 0.85 * mid) });
          links++;
        }
      }
      return true;
    }

    function frame(t) {
      const pal = isLight() ? PALETTE.light : PALETTE.dark;
      const font = getComputedStyle(document.body).fontFamily;
      const time = t / 1000;

      if (intro < 1) intro = Math.min(1, intro + 0.019);
      const io = reduce ? 1 : 1 - Math.pow(1 - intro, 3);   // easeOutCubic

      // fare parallax'ını yumuşat
      ease.x += (target.x - ease.x) * 0.06;
      ease.y += (target.y - ease.y) * 0.06;

      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.clearRect(0, 0, W, H);

      // --- güncel konumlar ---
      for (const n of nodesP) {
        const drift = reduce ? 0 : 1;
        const ox = Math.cos(time * n.sp + n.ph) * n.amp * drift;
        const oy = Math.sin(time * n.sp * 0.82 + n.ph * 1.4) * n.amp * 0.7 * drift;
        const px = ease.x * n.depth * 26 + pan.x * n.depth;
        const py = ease.y * n.depth * 20 + pan.y * n.depth;
        // açılışta düğümler merkezden dışa doğru yerleşir
        const sx = W / 2 + (n.bx - W / 2) * (0.72 + 0.28 * io);
        const sy = H / 2 + (n.by - H / 2) * (0.72 + 0.28 * io);
        n.cx = sx + ox + px;
        n.cy = sy + oy + py;
      }

      // --- kenarlar ---
      ctx.lineWidth = 0.75;
      for (const e of edges) {
        const a = nodesP[e.a], b = nodesP[e.b];
        ctx.strokeStyle = `rgba(${pal.edge},${(e.w * io).toFixed(3)})`;
        ctx.beginPath();
        ctx.moveTo(a.cx, a.cy);
        ctx.lineTo(b.cx, b.cy);
        ctx.stroke();
      }

      // --- etiketler ---
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      for (const n of nodesP) {
        ctx.font = `${n.hub ? 650 : 500} ${n.size}px ${font}`;
        ctx.globalAlpha = n.alpha * io;
        ctx.fillStyle = `rgb(${n.accent ? pal.accent : pal.base})`;
        ctx.fillText(n.t, n.cx, n.cy);
      }
      ctx.globalAlpha = 1;

      // --- merkez maskesi ---
      const narrow = W < 760;
      const g = ctx.createRadialGradient(
        W / 2, H * 0.47, 0,
        W / 2, H * 0.47, Math.max(W, H) * (narrow ? 0.72 : 0.52)
      );
      g.addColorStop(0, "rgba(0,0,0,1)");
      g.addColorStop(narrow ? 0.42 : 0.30, "rgba(0,0,0,0.97)");
      g.addColorStop(narrow ? 0.68 : 0.58, "rgba(0,0,0,0.62)");
      g.addColorStop(1, "rgba(0,0,0,0)");
      ctx.globalCompositeOperation = "destination-out";
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = "source-over";

      if (running) requestAnimationFrame(frame);
    }

    function start() {
      if (!build()) return;
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }

    start();

    // --- fare parallax ---
    const host = canvas.parentElement;
    if (!reduce && window.matchMedia("(pointer: fine)").matches) {
      window.addEventListener("pointermove", (e) => {
        const r = host.getBoundingClientRect();
        if (e.clientY > r.bottom) return;
        target.x = (e.clientX / window.innerWidth - 0.5) * 2;
        target.y = (e.clientY / Math.max(r.height, 1) - 0.5) * 2;
      }, { passive: true });
    }

    // --- sürükleyerek kaydırma (yalnız imleçli cihazlarda; mobilde sayfa kaydırmasını bozmasın) ---
    if (window.matchMedia("(pointer: fine)").matches) {
      host.style.pointerEvents = "auto";
      host.style.cursor = "grab";
      let drag = null;
      host.addEventListener("pointerdown", (e) => {
        drag = { x: e.clientX, y: e.clientY, px: pan.x, py: pan.y };
        host.style.cursor = "grabbing";
        host.setPointerCapture(e.pointerId);
      });
      host.addEventListener("pointermove", (e) => {
        if (!drag) return;
        pan.x = drag.px + (e.clientX - drag.x);
        pan.y = drag.py + (e.clientY - drag.y);
      });
      const end = () => { drag = null; host.style.cursor = "grab"; };
      host.addEventListener("pointerup", end);
      host.addEventListener("pointercancel", end);
    }

    // --- sekme görünmezken döngüyü durdur (pil/CPU) ---
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { running = false; }
      else if (!running) { running = true; requestAnimationFrame(frame); }
    });

    // --- görünürlük dışına çıkınca da durdur ---
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        const visible = entries[0].isIntersecting;
        if (!visible) running = false;
        else if (!running && !document.hidden) { running = true; requestAnimationFrame(frame); }
      }, { threshold: 0 }).observe(host);
    }

    let lastW = window.innerWidth;
    window.addEventListener("resize", () => {
      if (Math.abs(window.innerWidth - lastW) < 40) return;
      lastW = window.innerWidth;
      pan = { x: 0, y: 0 };
      build();
    });

    // tema değişimi döngünün kendi renk okumasıyla zaten yakalanıyor
    document.fonts?.ready.then(() => build());
  })();
</script>
